# =============================================================================
# IPO Workbench .gitignore
# 分组维护，便于阅读与扩展。
# =============================================================================

# ----- 系统/操作系统 ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- 编辑器/IDE ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.trae/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ----- 依赖 ------------------------------------------------------------------
node_modules/
# 项目使用 npm，pnpm-lock.yaml / yarn.lock 不入库
pnpm-lock.yaml
yarn.lock

# ----- 构建产物 --------------------------------------------------------------
dist/
dist-ssr/
dist-electron/
release/
out/
*.local

# Electron 打包源资源（最终图标在 build/icon.png 已入库）
icon.iconset/

# ----- 日志与调试 ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dev.log
debug/
temp.css
*.tmp

# ----- 环境变量与密钥 --------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ----- Claude Code / Agent 用户态 -------------------------------------------
# Claude Code 用户级配置/凭证
.claude/
.claude.json
.claude.json.*
.claude.json.backup.*
# Claude Agent SDK 运行时数据
.agent/
projects/
todos/
plans/
images/
shell-snapshots/
session-env/
settings.json

# ----- 应用本地工作区数据 ----------------------------------------------------
# IPO Workbench 工作区
.ipo/

# ----- 参考资料/调研（仅本地保留） -------------------------------------------
.references/
cherry-studio参考/
前端参考/

# ----- 子项目（独立仓库，不在主仓库追踪） ------------------------------------
mobile-app/
cloud-relay/

# ----- 内部文档/AI 指令（开源仓库不公开） ------------------------------------
# 内部施工文档、设计文档、接口文档等
/docs/
# 给 Claude Code / AI 助手的项目指令文件（含个人偏好）
CLAUDE.md
Claude.md
AGENTS.md
# 内部辅助说明（含本地绝对路径）
SUBREPOS.md
# 变更日志按团队偏好不入库
CHANGELOG.md

# ----- 临时/草稿 -------------------------------------------------------------
*.bak
*.orig
*.rej

# ----- 测试覆盖率 ------------------------------------------------------------
coverage/
.nyc_output/

# ----- 缓存 ------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
