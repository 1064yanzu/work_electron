{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"useHookAtTopLevel": "error",
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"formatter": {
		"formatWithErrors": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"src/**",
			"electron/**",
			"vite.config.ts",
			"package.json",
			"tsconfig*.json"
		]
	}
}
