		"build:mac": "tsc && vite build && electron-builder --mac",
		"build:win": "tsc && vite build && electron-builder --win",
		"build:all": "tsc && vite build && electron-builder --mac --win",
		"lint": "biome check src electron vite.config.ts package.json tsconfig*.json",
		"format": "biome format src electron vite.config.ts package.json tsconfig*.json --write",
