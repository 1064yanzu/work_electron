{
  "name": "ipo-workbench",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/clean-build.mjs --dev",
    "dev": "vite",
    "clean:build": "node scripts/clean-build.mjs",
    "prepare:build": "npm run clean:build && node scripts/generate-icons.mjs && node scripts/copy-pdfjs-assets.mjs",
    "verify:claude-native": "node scripts/verify-claude-native-binaries.mjs",
    "verify:mac:x64": "node scripts/verify-mac-package-architectures.mjs --arch=x64",
    "verify:mac:arm64": "node scripts/verify-mac-package-architectures.mjs --arch=arm64",
    "generate:latest-mac": "node scripts/generate-latest-mac-yml.mjs",
    "build": "npm run prepare:build && tsc && vite build && electron-builder",
    "build:mac": "npm run build:mac:arm64",
    "build:mac:x64": "npm run prepare:build && npm run verify:claude-native -- --targets=darwin-x64 && tsc && vite build && electron-builder --mac --x64 --publish never && npm run verify:mac:x64",
    "build:mac:arm64": "npm run prepare:build && npm run verify:claude-native -- --targets=darwin-arm64 && tsc && vite build && electron-builder --mac --arm64 --publish never && npm run verify:mac:arm64",
    "build:win": "npm run prepare:build && npm run verify:claude-native -- --targets=win32-x64 && tsc && vite build && electron-builder --win nsis",
    "build:all": "npm run prepare:build && tsc && vite build && electron-builder --mac --win",
    "lint": "biome check src electron vite.config.ts package.json tsconfig*.json && node scripts/check-hardcoded-colors.mjs",
    "format": "biome format src electron vite.config.ts package.json tsconfig*.json --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "sync:open-design": "node scripts/sync-open-design.mjs",
    "sync:open-design:update": "node scripts/sync-open-design.mjs --update",
    "postinstall": "npx @electron/rebuild -m . -w node-pty && node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.139",
    "@fontsource/inter": "^5.2.8",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "@libsql/client": "^0.17.0",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "archiver": "^7.0.1",
    "bufferutil": "^4.1.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff": "^8.0.2",
    "discord.js": "^14.25.1",
    "dompurify": "^3.3.0",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "grammy": "^1.40.0",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.8.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "node-pty": "^1.1.0",
    "node-stream-zip": "^1.15.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "react-resizable-panels": "^3.0.6",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.2.2",
    "utf-8-validate": "^6.0.6",
    "webdav": "^5.8.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@electron/rebuild": "^4.0.3",
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/lz-string": "^1.3.34",
    "@types/qrcode": "^1.5.6",
    "@types/node": "^25.0.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.8",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "main": "dist-electron/index.js"
}
